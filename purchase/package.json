{
  "name": "kk-gov-purchase",
  "private": true,
  "description": "Облік закупівель: NestJS (BFF) + React + PostgreSQL",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web && npm run build -w apps/api",
    "start": "npm run start -w apps/api",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "test": "npm test -w apps/api"
  },
  "engines": {
    "node": ">=20"
  }
}
