<%
  const t = total > 0 ? total : 1;
  const rec = Math.round(received / t * 1000) / 10;
  const can = Math.round(cancelled / t * 1000) / 10;
%>
<div class="progress-stacked" style="height: 8px" title="Отримано <%= rec %>% · Не зможуть <%= can %>%">
    <div class="progress" style="width: <%= rec %>%"><div class="progress-bar bg-success"></div></div>
    <div class="progress" style="width: <%= can %>%"><div class="progress-bar bg-danger"></div></div>
</div>
