<%- include('../partials/header') %>

<a href="/contracts/<%= contract.id %>" class="small">&larr; до договору</a>
<h1 class="h3 mb-1">Нова поставка</h1>
<p class="text-muted">Договір № <%= contract.number %> від <%= f.date(contract.contract_date) %> · <%= contract.counterparty %></p>

<form method="post" action="/contracts/<%= contract.id %>/deliveries" enctype="multipart/form-data">
    <% if (errors._) { %><div class="alert alert-danger"><%= errors._ %></div><% } %>

    <div class="card mb-4">
        <div class="card-body row g-3">
            <div class="col-md-3">
                <label class="form-label" for="date">Дата поставки</label>
                <input class="form-control <%= errors.date ? 'is-invalid' : '' %>" type="date" id="date" name="date" value="<%= form.date %>" required>
                <%- include('../partials/error-text', { message: errors.date }) %>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="invoice_number">Номер накладної</label>
                <input class="form-control <%= errors.invoice_number ? 'is-invalid' : '' %>" id="invoice_number" name="invoice_number"
                       value="<%= form.invoice_number %>" maxlength="100" required autocomplete="off">
                <%- include('../partials/error-text', { message: errors.invoice_number }) %>
            </div>
            <div class="col-md-5">
                <label class="form-label" for="file">Скан накладної</label>
                <input class="form-control" type="file" id="file" name="file">
            </div>
            <div class="col-12">
                <label class="form-label" for="notes">Примітки</label>
                <textarea class="form-control" id="notes" name="notes" rows="2" maxlength="2000"><%= form.notes %></textarea>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
            Що приїхало
            <button type="button" class="btn btn-sm btn-outline-secondary" id="fill-all">Заповнити все, що очікуємо</button>
        </div>
        <div class="card-body p-0">
            <table class="table mb-0 align-middle">
                <thead class="table-light">
                <tr>
                    <th>Найменування</th>
                    <th class="text-end">Замовлено</th>
                    <th class="text-end">Очікуємо</th>
                    <th style="width: 190px">Приїхало</th>
                </tr>
                </thead>
                <tbody>
                <% contract.items.forEach((item, i) => { const e = errors[`line.${item.id}`]; %>
                    <tr class="<%= item.pending <= 0 ? 'text-muted' : '' %>">
                        <td>
                            <input type="hidden" name="lines[<%= i %>][item_id]" value="<%= item.id %>">
                            <%= item.name %>
                        </td>
                        <td class="text-end text-nowrap"><%= f.qty(item.quantity) %> <%= item.unit %></td>
                        <td class="text-end text-nowrap fw-semibold"><%= f.qty(item.pending) %></td>
                        <td>
                            <div class="input-group">
                                <input class="form-control delivery-qty <%= e ? 'is-invalid' : '' %>" type="number" step="any" min="0"
                                       max="<%= f.qtyInput(item.pending) %>" data-pending="<%= f.qtyInput(item.pending) %>"
                                       name="lines[<%= i %>][quantity]" value="<%= form.lines[item.id] ?? '' %>"
                                       <%= item.pending <= 0 ? 'disabled' : '' %>>
                                <span class="input-group-text"><%= item.unit %></span>
                            </div>
                            <%- include('../partials/error-text', { message: e }) %>
                        </td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <button type="submit" class="btn btn-success">Зберегти поставку</button>
    <a href="/contracts/<%= contract.id %>" class="btn btn-link">Скасувати</a>
</form>

<%- include('../partials/footer') %>
