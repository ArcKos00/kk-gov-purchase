<%- include('../partials/header') %>
<% const c = contract; %>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <a href="/contracts" class="small">&larr; до списку</a>
        <h1 class="h3 mb-1">Договір № <%= c.number %> <%- include('../partials/status', { status: c.status }) %></h1>
        <div class="text-muted"><%= c.counterparty %></div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-success" href="/contracts/<%= c.id %>/deliveries/new">+ Додати поставку</a>
        <a class="btn btn-outline-primary" href="/contracts/<%= c.id %>/update">Недопоставка / дата</a>
        <a class="btn btn-outline-secondary" href="/contracts/<%= c.id %>/edit">Редагувати</a>
        <form method="post" action="/contracts/<%= c.id %>/delete" data-confirm="Видалити договір разом з усіма поставками і файлами?">
            <button class="btn btn-outline-danger" type="submit">Видалити</button>
        </form>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Номер договору</dt>
            <dd class="col-sm-9"><%= c.number %></dd>
            <dt class="col-sm-3">Дата договору</dt>
            <dd class="col-sm-9"><%= f.date(c.contract_date) %></dd>
            <dt class="col-sm-3">Контрагент</dt>
            <dd class="col-sm-9"><%= c.counterparty %></dd>
            <dt class="col-sm-3">Орієнтовна дата поставки</dt>
            <dd class="col-sm-9">
                <%= f.date(c.expected_delivery_date) %>
                <% if (c.status === 'overdue') { %><span class="text-danger small ms-1">(прострочено)</span><% } %>
            </dd>
            <dt class="col-sm-3">Файл договору</dt>
            <dd class="col-sm-9">
                <% if (c.file_id) { %>
                    <a href="/files/<%= c.file_id %>"><%= c.file_name %></a>
                    <span class="text-muted small">(<%= f.fileSize(Number(c.file_size)) %>)</span>
                <% } else { %>
                    <span class="text-muted">не завантажено</span>
                <% } %>
            </dd>
            <% if (c.notes) { %>
                <dt class="col-sm-3">Примітки</dt>
                <dd class="col-sm-9 pre-line"><%= c.notes %></dd>
            <% } %>
        </dl>
    </div>
</div>

<h2 class="h5">Найменування</h2>
<div class="table-responsive mb-4">
    <table class="table align-middle">
        <thead class="table-light">
        <tr>
            <th>Найменування</th>
            <th class="text-end">Замовлено</th>
            <th class="text-end text-success">Отримано</th>
            <th class="text-end text-primary">Очікуємо</th>
            <th class="text-end text-danger">Не зможуть</th>
            <th style="min-width: 120px"></th>
        </tr>
        </thead>
        <tbody>
        <% for (const i of c.items) { %>
            <tr>
                <td>
                    <%= i.name %>
                    <% if (i.cancel_reason) { %><div class="small text-danger"><%= i.cancel_reason %></div><% } %>
                </td>
                <td class="text-end text-nowrap"><%= f.qty(i.quantity) %> <%= i.unit %></td>
                <td class="text-end text-nowrap"><%= f.qty(i.received) %></td>
                <td class="text-end text-nowrap fw-semibold"><%= f.qty(i.pending) %></td>
                <td class="text-end text-nowrap"><%= f.qty(i.cancelled_quantity) %></td>
                <td><%- include('../partials/progress', { total: i.quantity, received: i.received, cancelled: i.cancelled_quantity }) %></td>
            </tr>
        <% } %>
        </tbody>
    </table>
</div>

<h2 class="h5">Поставки</h2>
<% if (c.deliveries.length === 0) { %>
    <p class="text-muted">Поставок ще не було.</p>
<% } else { %>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-light">
            <tr>
                <th>Дата</th>
                <th>Накладна</th>
                <th>Що приїхало</th>
                <th>Файл</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            <% for (const d of c.deliveries) { %>
                <tr>
                    <td class="text-nowrap"><%= f.date(d.date) %></td>
                    <td>
                        № <%= d.invoice_number %>
                        <% if (d.notes) { %><div class="small text-muted pre-line"><%= d.notes %></div><% } %>
                    </td>
                    <td class="small">
                        <% for (const l of d.lines) { %>
                            <div><%= l.item.name %> — <%= f.qty(l.quantity) %> <%= l.item.unit %></div>
                        <% } %>
                    </td>
                    <td><% if (d.file_id) { %><a href="/files/<%= d.file_id %>"><%= d.file_name %></a><% } %></td>
                    <td class="text-end">
                        <form method="post" action="/deliveries/<%= d.id %>/delete" data-confirm="Видалити цю поставку?">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Видалити</button>
                        </form>
                    </td>
                </tr>
            <% } %>
            </tbody>
        </table>
    </div>
<% } %>

<%- include('../partials/footer') %>
