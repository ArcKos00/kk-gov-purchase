PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orders
UPLOADS_DIR=data/uploads
MAX_UPLOAD_MB=50

# --- Автентифікація ---
# Обов'язково в продакшені (≥ 32 символів): openssl rand -base64 48
SESSION_SECRET=
# Перший адміністратор — створюється лише якщо в БД ще немає користувачів
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Адміністратор
# Cookie лише по HTTPS (за замовчуванням — true при NODE_ENV=production)
COOKIE_SECURE=
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_ATTEMPTS=30
# Довіра до X-Forwarded-For: true/false, кількість проксі або перелік мереж
TRUST_PROXY=loopback, linklocal, uniquelocal
